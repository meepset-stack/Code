-- Key Check Function
local function checkKey(input_key, messageLabel, gui)
    local status = API.check_key(input_key)

    if status.code == "KEY_VALID" then
        writefile(key_path, input_key)
        messageLabel.Text = "Success! Loading script..."
        task.wait(1)
        gui:Destroy()
        API.load_script()
        return true

    elseif status.code == "KEY_HWID_LOCKED" then
        messageLabel.Text = "Key locked to another device!"
        return false

    elseif status.code == "KEY_INCORRECT" then
        messageLabel.Text = "Incorrect Key!"
        return false

    elseif status.code == "KEY_INVALID" then
        messageLabel.Text = "Invalid or expired key!"
        return false

    else
        messageLabel.Text = "Error: " .. (status.message or "Unknown")
        return false
    end
end

